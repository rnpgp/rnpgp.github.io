---
interface Props {
  variant?: 'band' | 'strip' | 'inline';
  class?: string;
}

const { variant = 'band', class: className = '' } = Astro.props;

// Single source of truth for RNP's public funder attribution.
// See memory/project_sponsors.md for verified provenance.
const funders = [
  {
    name: 'NLnet Foundation',
    href: 'https://nlnet.nl/',
    logo: '/assets/sponsors/nlnet.svg',
    logoDark: '/assets/sponsors/nlnet-white.svg',
    logoClass: 'h-10 w-auto',
    blurb: 'Privacy & trust enhancing technology grant.',
  },
  {
    name: 'NGI Zero PET',
    href: 'https://nlnet.nl/thema/NGIZeroPET.html',
    logo: '/assets/sponsors/ngi-zero-pet.svg',
    logoDark: '/assets/sponsors/ngi-zero-pet.svg',
    logoClass: 'h-8 w-auto',
    blurb:
      'Next Generation Internet — Privacy & Trust Enhancing Technologies. Funded through the European Commission.',
  },
  {
    name: 'Mozilla',
    href: 'https://github.com/mozilla/moss-directory',
    logo: '/assets/sponsors/mozilla.svg',
    logoDark: '/assets/sponsors/mozilla-white.svg',
    logoClass: 'h-5 w-auto',
    blurb:
      'Mozilla Open Source Support (MOSS) — Foundational Technology & Secure Open Source funds.',
  },
];

const eu = {
  text: 'Funded by the European Union — Next Generation Internet',
  href: 'https://ngi.eu/',
  flag: '/assets/sponsors/eu-flag.svg',
};
---

{
  variant === 'band' && (
    <section class={`sponsors-band border-b border-line ${className}`}>
      <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 px-6 py-6 sm:flex-row sm:justify-between sm:gap-6 md:py-7">
        <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-start">
          <span class="mono-label shrink-0">Supported by</span>
          {funders.map((f) => (
            <a
              href={f.href}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center justify-center rounded-lg border border-transparent px-3 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-line hover:bg-surface dark:hover:border-white/10 dark:hover:bg-white/5"
              aria-label={`${f.name} — opens in new tab`}
            >
              <img
                src={f.logo}
                alt={`${f.name} logo`}
                class:list={[f.logoClass, f.logoDark !== f.logo && 'dark:hidden']}
                loading="lazy"
                decoding="async"
              />
              {f.logoDark !== f.logo && (
                <img
                  src={f.logoDark}
                  alt=""
                  aria-hidden="true"
                  class:list={[f.logoClass, 'hidden dark:block']}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
          ))}
        </div>
        <a
          href={eu.href}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 font-mono text-[0.7rem] leading-snug text-muted underline decoration-line underline-offset-2 transition-colors hover:text-foreground hover:decoration-accent"
        >
          <img
            src={eu.flag}
            alt=""
            class="h-3.5 w-auto rounded-[1px] ring-1 ring-black/10"
            loading="lazy"
            decoding="async"
          />
          {eu.text}
        </a>
      </div>
    </section>
  )
}

{
  variant === 'strip' && (
    <div
      class={`flex flex-col items-center gap-2 border-t border-white/10 pt-6 text-center sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3 sm:gap-y-1 ${className}`}
    >
      <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-[#5f6788]">
        Funded by
      </span>
      {funders.map((f, i) => (
        <span class="inline-flex items-center gap-3">
          <a
            href={f.href}
            target="_blank"
            rel="noopener"
            class="font-mono text-xs text-[#a8aec9] underline decoration-white/15 underline-offset-2 transition-colors hover:text-white hover:decoration-white/45"
          >
            {f.name}
          </a>
          {i < funders.length - 1 && (
            <span class="text-[#3a4063]" aria-hidden="true">
              ·
            </span>
          )}
        </span>
      ))}
      <span class="text-[#3a4063]" aria-hidden="true">·</span>
      <a
        href={eu.href}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-[#a8aec9] underline decoration-white/15 underline-offset-2 transition-colors hover:text-white hover:decoration-white/45"
      >
        <img src={eu.flag} alt="" class="h-3.5 w-auto" loading="lazy" decoding="async" />
        {eu.text}
      </a>
    </div>
  )
}

{
  variant === 'inline' && (
    <div class={`space-y-3 ${className}`}>
      {funders.map((f) => (
        <a
          href={f.href}
          target="_blank"
          rel="noopener"
          class="card card-hover group flex items-center gap-5 p-5"
        >
          <span class="flex h-14 w-28 shrink-0 items-center justify-center">
            <img
              src={f.logo}
              alt={`${f.name} logo`}
              class:list={[f.logoClass, f.logoDark !== f.logo && 'dark:hidden']}
              loading="lazy"
              decoding="async"
            />
            {f.logoDark !== f.logo && (
              <img
                src={f.logoDark}
                alt=""
                aria-hidden="true"
                class:list={[f.logoClass, 'hidden dark:block']}
                loading="lazy"
                decoding="async"
              />
            )}
          </span>
          <div class="min-w-0">
            <h4 class="font-sans text-lg font-bold transition-colors group-hover:text-accent">
              {f.name}
            </h4>
            <p class="mt-0.5 text-sm leading-relaxed text-muted">{f.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  )
}

<style>
  /* Neutral band — soft surface wash that stays legible in both themes.
     Avoids the muddy dark-teal of .band-teal under multicolor brand marks. */
  .sponsors-band {
    background:
      radial-gradient(60rem 18rem at 50% -40%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 70%),
      var(--surface-dim);
  }
  :global(.dark) .sponsors-band {
    background:
      radial-gradient(60rem 18rem at 50% -40%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
      var(--surface);
  }
</style>
